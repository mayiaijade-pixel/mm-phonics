  "u3-0": [
    {
      "text": "Hi, Jenny!",
      "audio": "/audio/long-i/31ac4e38e4f8aefaeac4.mp3"
    },
    {
      "text": "Let's discover magic with the letter i!",
      "audio": "/audio/long-i/c275f7cbbe542a6c9812.mp3"
    }
  ],
  "u3-1": [
    {
      "text": "Look, Jenny!",
      "audio": "/audio/long-i/7c5c9fc520dc30c93ad4.mp3"
    },
    {
      "text": "This is a pin.",
      "audio": "/audio/long-i/16759a083060822b6358.mp3"
    },
    {
      "text": "Listen to the short i sound in pin.",
      "audio": "/audio/long-i/e6bc551c296bdd4d9107.mp3"
    },
    {
      "text": "Now say pin with me!",
      "audio": "/audio/long-i/5b74b5a42c7003fd5efc.mp3"
    }
  ],
  "u3-2": [
    {
      "text": "Pin meets magic e!",
      "audio": "/audio/long-i/04e3b6d32b38e844584d.mp3"
    },
    {
      "text": "Now pin plus e makes pine!",
      "audio": "/audio/long-i/40ee41e51297cef74c73.mp3"
    },
    {
      "text": "The i says eye, and the final e is silent.",
      "audio": "/audio/long-i/7a1d026115f703cfac8a.mp3"
    }
  ],
  "u3-3": [
    {
      "text": "When short i meets magic e!?",
      "audio": "/audio/long-i/3e6e559ef1a4d4b734ec.mp3"
    },
    {
      "text": "It makes the sound /aɪ/!",
      "audio": "/audio/long-i/75aea43e237ec73c5ab7.mp3"
    }
  ],
  "u3-5": [
    {
      "text": "Jenny, listen to the word.",
