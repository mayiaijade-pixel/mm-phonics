  "u2-0": [
    {
      "text": "Hi, Jenny!",
      "audio": "/audio/unit2/31ac4e38e4f8aefaeac4.mp3"
    },
    {
      "text": "Welcome back! Let's learn more long a words!",
      "audio": "/audio/letter-a/2ca8d4c842d2e7efb1de.mp3"
    }
  ],
  "u2-1": [
    {
      "text": "Look, Jenny! This is a can.",
      "audio": "/audio/unit2/242b2c97084d77a822a9.mp3"
    },
    {
      "text": "Listen to the short a sound in can.",
      "audio": "/audio/letter-a/02c139162fe295c849eb.mp3"
    },
    {
      "text": "Now say can with me!",
      "audio": "/audio/unit2/eee2a6fdf8f511916784.mp3"
    }
  ],
  "u2-2": [
    {
      "text": "Can meets magic e!",
      "audio": "/audio/unit2/562882312c347394582e.mp3"
    },
    {
      "text": "Now can plus e makes cane!",
      "audio": "/audio/unit2/e8d905828927bb235d56.mp3"
    },
    {
      "text": "The a says ay, and the final e is silent.",
      "audio": "/audio/letter-a/6eb862063d9ba7b9dd16.mp3"
    }
  ],
  "u2-3": [
    {
      "text": "When short a meets magic e!?",
      "audio": "/audio/letter-a/df36be944b7070f2812c.mp3"
    },
    {
      "text": "It makes the sound /eɪ/!",
      "audio": "/audio/unit2/d053a695f0c10f8a9ac1.mp3"
    }
  ],
  "u2-5": [
    {
      "text": "Jenny, listen to the word.",
      "audio": "/audio/unit2/51dfeb2037dd0c79a302.mp3"
    },
    {
      "text": "Then tap the matching picture!",
      "audio": "/audio/unit2/8d0498564c1d64846b21.mp3"
    }
  ],
  "u2-6": [
    {
      "text": "Jenny, tap magic e.",
      "audio": "/audio/unit2/0b66e80767a70859e25a.mp3"
    },
    {
      "text": "Put it at the end of can.",
      "audio": "/audio/unit2/6c3e3c75336f47c05966.mp3"
    },
    {
      "text": "Let’s make cane!",
      "audio": "/audio/unit2/62f985b397a68d627450.mp3"
    }
  ],
  "u2-7": [
