{
  "1": [
    {
      "text": "Look, Jenny!",
      "audio": "/audio/fena/phonics-v3-ae5f4b0062fc36b7.mp3"
    },
    {
      "text": "This is a cap.",
      "audio": "/audio/fena/phonics-v3-d918d559594bd18e.mp3"
    },
    {
      "text": "Listen to the short a sound in cap.",
      "audio": "/audio/letter-a/b66bf72b6ead4f346a50.mp3"
    },
    {
      "text": "Now say cap with me!",
      "audio": "/audio/fena/phonics-v3-eb90602cb8e9204e.mp3"
    }
  ],
  "2": [
    {
      "text": "Cap meets magic e!",
      "audio": "/audio/fena/phonics-v3-f4b9de251a0723a5.mp3"
    },
    {
      "text": "Now cap plus e makes cape!",
      "audio": "/audio/fena/phonics-v3-40d053a6b831ad8d.mp3"
    }
  ],
  "3": [
    {
      "text": "When short a meets magic e!?",
      "audio": "/audio/letter-a/5d358cdad1c30eaad646.mp3"
    },
    {
      "text": "It makes the sound /eɪ/!",
      "audio": ""
    }
  ],
  "5": [
    {
      "text": "Jenny, listen to the word.",
      "audio": "/audio/fena/phonics-v3-5cce7492cb5a18d9.mp3"
    },
    {
      "text": "Then tap the matching picture!",
      "audio": "/audio/fena/phonics-v3-bb881060ef92cfdf.mp3"
    }
  ],
  "6": [
    {
      "text": "Jenny, tap magic e.",
      "audio": "/audio/fena/phonics-v3-8d7074c0b1075147.mp3"
    },
    {
      "text": "Put it at the end of cap.",
      "audio": "/audio/fena/phonics-v3-e3d16e2af49e2481.mp3"
    },
    {
      "text": "Let’s make cape!",
      "audio": "/audio/fena/phonics-v3-43fe9c50f9fcb095.mp3"
    }
  ],
  "7": [
    {
      "text": "Great job, Jenny!",
      "audio": "/audio/fena/phonics-v3-2307e86262a8b01e.mp3"
    },
    {
      "text": "You discovered magic e!",
      "audio": "/audio/fena/phonics-v3-7889274d8c567ccd.mp3"
    },
    {
      "text": "For homework, work on Unit 1 in Speed Phonics Book 2.",
      "audio": "/audio/fena/phonics-v3-755438c607122b1a.mp3"
    },
    {
      "text": "Do pages 4 to 9 with your mom!",
      "audio": "/audio/fena/phonics-v3-1f63f702f979deac.mp3"
    }
  ],
